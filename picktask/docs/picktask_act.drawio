<mxfile host="65bd71144e">
    <diagram id="picktask-act" name="PickTask ACT Architecture">
        <mxGraphModel dx="1032" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" background="#1A1F2E" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
